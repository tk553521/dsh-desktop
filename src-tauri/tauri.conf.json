{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH Desktop",
  "version": "0.1.0",
  "identifier": "dev.dsh.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "splash",
        "title": "DSH Desktop",
        "url": "index.html",
        "width": 1040,
        "height": 680,
        "minWidth": 840,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "resizable": true,
        "shadow": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "DeveloperTool",
    "shortDescription": "DeepSeek Harness as a native Windows app",
    "longDescription": "DSH Desktop bundles the complete DeepSeek Harness runtime (pinned @deepseek-ai/dsh tree plus its Node.js runtime) and serves the full browser agent experience in a single Windows application — sessions, tools, goals, subagents, workflows and settings all live in your existing ~/.dsh home.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/**/*"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
